    "m_SourceType": 1,
    "m_FunctionName": "ColorTheThing",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "if (tex.a < 1) {\n\tdiscard;\n}\n\nfloat3 mask = tex.rgb;\n\ncolor = colorLeft * mask.r + colorRight * mask.g + colorTop * mask.b;\n"
}

